# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
indent_style = space
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# C/C++ files
[*.{c,h,cpp,hpp}]
indent_size = 4

# CMake files
[CMakeLists.txt,*.cmake]
indent_size = 4

# Markdown files
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Batch files
[*.bat]
end_of_line = crlf

# Windows resource files
[*.rc]
indent_size = 4
end_of_line = crlf